# 腾讯文档开放平台应用和用户 OAuth2 授权结果。
# 不要把真实值提交到 GitHub。
TENCENT_DOCS_OPENAPI_CLIENT_ID=YOUR_CLIENT_ID
TENCENT_DOCS_OPENAPI_OPEN_ID=YOUR_OPEN_ID
TENCENT_DOCS_OPENAPI_ACCESS_TOKEN=YOUR_ACCESS_TOKEN

# 可选；同时配置后，Access Token 失效时 MCP 会在进程内自动刷新一次。
TENCENT_DOCS_OPENAPI_CLIENT_SECRET=YOUR_CLIENT_SECRET
TENCENT_DOCS_OPENAPI_REFRESH_TOKEN=YOUR_REFRESH_TOKEN
